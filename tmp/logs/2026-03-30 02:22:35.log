            continue
            
        if parts1[0] != '+' and parts2[0] == '-':
            counter2 += 1
            continue
        
        # If we got here, the lines are semantically equivalent
        return True
    
    # Check that both patches have been fully processed
    if counter1 < len(patch1_lines) or counter2 < len(patch2_lines):
        return False
    
    # If we got here, the patches are semantically equivalent
    return True
