def detect_semantic_equivalence(patch1, patch2):
    # Split the patches into their individual sections
    p1 = patch1.split('\n')[3:]  # Skip the first three lines (metadata)
    p2 = patch2.split('\n')[3:]  # Skip the first three lines (metadata)
    
    # Initialize counters for each section
    context_diff = 0
    code_diff = 0
    metadata_diff = 0
    
    # Compare each section of the patches
    for line1, line2 in zip(p1, p2):
        if line1.startswith('@@') and line2.startswith('@@'):  # Context diff
            context_diff += 1
        elif not (line1.startswith('@@') or line2.startswith('@@')):  # Code diff
            code_diff += 1
    
    # If the number of context and code differences is equal, the patches are semantically equivalent
    if context_diff == code_diff:
        return 'yes'
    else:
        return 'no'
```
