    # Check for semantic equivalence by comparing the change lists for each file
    for file, changes1 in changes_per_file.items():
        changes2 = changes_per_file.get(file)
        if changes1 != changes2:  # Changes are not identical
            return 'no'
    
    return 'yes'
```

