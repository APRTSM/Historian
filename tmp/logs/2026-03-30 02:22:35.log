Here is a Python script for comparing two diff files:

```python
import re

def compare_diffs(file1, file2):
    with open(file1) as f1, open(file2) as f2:
        content1 = f1.read()
        content2 = f2.read()
        
        # Split the diff into blocks
        blocks1 = re.split('diff --git', content1)[1:]
        blocks2 = re.split('diff --git', content2)[1:]
        
        if len(blocks1) != len(blocks2):
            return False
        
        for b1, b2 in zip(blocks1, blocks2):
            # Split each block into header and changes
            header1, *changes1 = re.split('\n', b1)
            header2, *changes2 = re.split('\n', b2)
            
            if header1 != header2:
                return False
            
            # Compare each change in the block
            for c1, c2 in zip(changes1, changes2):
                if not compare_change(c1, c2):
                    return False
        
        return True

def compare_change(change1, change2):
    lines1 = re.split('\n', change1)
    lines2 = re.split('\n', change2)
    
    if len(lines1) != len(lines2):
        return False
    
    for l1, l2 in zip(lines1, lines2):
        # Ignore the first character (+ or -) and whitespace at the beginning of each line
        content1 = re.sub('^[ +-]', '', l1).lstrip()
        content2 = re.sub('^[ +-]', '', l2).lstrip()
        
        if content1 != content2:
            return False
    
    return True

# Usage
print(compare_diffs("file1.txt", "file2.txt"))  # Replace with your file names
```
This script compares two diff files and returns `True` if they are semantically equivalent, `False` otherwise. It assumes that the diff files follow a specific format where each block of changes starts with 'diff --git'. Each change in a block is separated by an empty line. The comparison ignores whitespace at the beginning of each line and only compares the content after the first character (+ or -).

