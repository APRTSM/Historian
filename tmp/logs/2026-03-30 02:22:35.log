def semantically_equivalent(patch1, patch2):
    # Split the patches into their individual parts
    patch1 = patch1.split('\n')[3:]  # Skip the first three lines (metadata)
    patch2 = patch2.split('\n')[3:]  # Skip the first three lines (metadata)
    
    # Initialize counters for each patch
    counter_patch1 = 0
    counter_patch2 = 0
    
    while counter_patch1 < len(patch1) and counter_patch2 < len(patch2):
        line1 = patch1[counter_patch1]
        line2 = patch2[counter_patch2]
        
        # If the lines are not equivalent, return 'no'
        if line1 != line2:
            return 'no'
        
        counter_patch1 += 1
        counter_patch2 += 1
    
    # If we have reached this point, all lines in both patches must be equal
    return 'yes'
