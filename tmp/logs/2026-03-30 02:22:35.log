    while counter1 < len(lines1) and counter2 < len(lines2):
        line1 = lines1[counter1].strip()
        line2 = lines2[counter2].strip()
        
        # If the lines are not equivalent, return 'no'
        if line1 != line2:
            return 'no'
        
        # Increment counters based on the type of line
        if line1.startswith('---') or line1.startswith('+++'):
            counter1 += 1
            counter2 += 1
        elif line1.startswith('@@'):
