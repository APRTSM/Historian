            continue
        if line2[0] in ('-', '+'):
            counter2 += 1
            continue
        
        # If the lines are not equivalent, return False
        if line1 != line2:
            return False
        
        # Move to the next lines
        counter1 += 1
        counter2 += 1
    
    # If we've reached this point, all lines were equal
    return True
```
