    # Split the patches into lines
    patch1_lines = patch1.split('\n')
    patch2_lines = patch2.split('\n')
    
    # Initialize counters for changes in each patch
    context_changes = 0
    content_changes = 0
    
    # Iterate over the lines of both patches
    for line1, line2 in zip(patch1_lines, patch2_lines):
        if line1.startswith('---') or line1.startswith('+++'):
            continue  # Skip these lines
        
        if line1.startswith('@@'):
            context_changes += 1  # Count the change in context
            
            # Extract the start and end positions from the '@@' line
            _, original, generated = line1.split()
            original_start, original_count = map(int, original.split('-')[0].split(','))
            generated_start, generated_count = map(int, generated.split(',')[0].split('-'))
            
            # Check if the start positions and counts are equivalent in both patches
            if not (original_start == generated_start and original_count == generated_count):
                content_changes += 1  # Count the change in content
        elif line1.startswith('+') or line1.startswith('-'):
            continue  # Skip these lines
        else:
            if line1 != line2:
                content_changes += 1  # Count the change in content
    
    # Check if there are any changes in context and/or content
    if context_changes > 0 or content_changes > 0:
        return 'no'
    else:
        return 'yes'
```
