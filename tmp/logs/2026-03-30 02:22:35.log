    while counter1 < len(patch1) and counter2 < len(patch2):
        line1 = patch1[counter1].strip()
        line2 = patch2[counter2].strip()
        
        # If both lines are empty or start with '---' or '+++', skip them
        if (not line1) or (line1.startswith('---') or line1.startswith('+++')):
            counter1 += 1
            continue
        if (not line2) or (line2.startswith('---') or line2.startswith('+++')):
            counter2 += 1
            continue
        
        # If the lines start with '@@' and contain a range, skip them
