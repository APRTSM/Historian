            if patch2_lines[i].strip().startswith('//') or not patch2_lines[i].strip():
                continue
            
            # If lines are equal, increment the corresponding counter
            if patch1_lines[i] == patch2_lines[i]:
                count1 += 1
                count2 += 1
        except IndexError:
            pass  # Ignore lines that don't exist in one of the patches
    
    # If both counters are equal, the patches are semantically equivalent
    return count1 == len(patch1_lines) and count2 == len(patch2_lines), (count1, count2)
```

