    changes_per_file = {}
    
    # Process each patch part
    for patch in [patch1, patch2]:
        current_file = None
        for line in patch:
            if line.startswith('---') or line.startswith('+++'):  # File change lines
                current_file = line[4:]  # Get the file name from the line
                changes_per_file[current_file] = []  # Initialize the list of changes for this file
            elif line.startswith('@@') or line.startswith('-') or line.startswith('+'):  # Change lines
                if current_file is not None:
