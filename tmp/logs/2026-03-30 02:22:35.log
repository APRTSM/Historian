    # Split the patches into lines
    patch1_lines = patch1.split('\n')
    patch2_lines = patch2.split('\n')
    
    # Initialize counters for each patch
    counter1 = 0
    counter2 = 0
    
    # Iterate over the patches
    while counter1 < len(patch1_lines) and counter2 < len(patch2_lines):
        line1 = patch1_lines[counter1].strip()
        line2 = patch2_lines[counter2].strip()
        
        # If both lines are empty, skip them
        if not line1 and not line2:
            counter1 += 1
            counter2 += 1
            continue
            
        # If one of the lines is empty but the other isn't, they aren't semantically equivalent
        if (not line1 and line2) or (line1 and not line2):
            return False
        
        # Check for differences in context lines
        if line1.startswith('-') != line2.startswith('-'):
            return False
            
        # If the lines are unchanged, skip them
        if line1[1:] == line2[1:]:
            counter1 += 1
            counter2 += 1
            continue
        
        # Check for differences in changed lines
        parts1 = line1.split(' ', 3)
        parts2 = line2.split(' ', 3)
        
        if len(parts1) != 4 or len(parts2) != 4:
