def semantically_equivalent(patch1, patch2):
    # Split the patches into lines and remove any leading or trailing whitespace
    patch1_lines = [line.strip() for line in patch1.split('\n') if line.strip()]
    patch2_lines = [line.strip() for line in patch2.split('\n') if line.strip()]
    
    # Check if the two patches have the same number of lines
    if len(patch1_lines) != len(patch2_lines):
        return 'no'
    
    # Iterate over each pair of corresponding lines in the two patches
    for line1, line2 in zip(patch1_lines, patch2_lines):
        # If the lines are not identical, they are not semantically equivalent
        if line1 != line2:
            return 'no'
    
    # All pairs of corresponding lines were identical, so the patches are semantically equivalent
    return 'yes'
