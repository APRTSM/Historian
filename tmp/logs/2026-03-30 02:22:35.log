def semantically_equivalent(patch1, patch2):
    # Split the patches into lines
    lines1 = patch1.split('\n')
    lines2 = patch2.split('\n')
    
    # Initialize counters for each patch
    counter1 = 0
    counter2 = 0
    
    # Iterate over both lists of lines simultaneously
    while counter1 < len(lines1) and counter2 < len(lines2):
        line1 = lines1[counter1].strip()
        line2 = lines2[counter2].strip()
        
        # If the current line starts with '---' or '+++', skip it (metadata)
        if line1.startswith('---') or line1.startswith('+++') or line2.startswith('---') or line2.startswith('+++'):
            counter1 += 1
            counter2 += 1
            continue
        
        # If the current lines start with '@@', parse the numbers and increment the counters
        if line1.startswith('@@') and line2.startswith('@@'):
            _, nums1 = line1.split(' ', 1)[-1].split(',')
            _, nums2 = line2.split(' ', 1)[-1].split(',')
            
            counter1 += int(nums1[0])
            counter2 += int(nums2[0])
        
        # If the current lines start with '-' or '+', skip them (deletions and additions)
        elif line1.startswith('-') or line2.startswith('+'):
            counter1 += 1
            counter2 += 1
            
        # If the current lines are unchanged, increment both counters
        elif not line1.startswith(' '):
            counter1 += 1
            counter2 += 1
        
        else:  # The current lines are modifications
            # Check if they have different numbers of changes after the '@@' and before '-', '+', or ''
            _, nums1 = line1.split(' ', 1)[-1].split(',')
            _, nums2 = line2.split(' ', 1)[-1].split(',')
            
            if nums1[0] != nums2[0]:
                return False
        
            # Check if the modified lines are semantically equivalent
            parts1 = [part for part in line1.split() if not part.startswith('-') and not part.startswith('+')]
            parts2 = [part for part in line2.split() if not part.startswith('-') and not part.startswith('+')]
            
            if len(parts1) != len(parts2):
                return False
            
            # Check if the modified lines have different content
            for part1, part2 in zip(parts1, parts2):
                if part1[1:] != part2[1:]:
                    return False
        
        counter1 += 1
        counter2 += 1
    
    # If all lines were processed and no differences were found, the patches are semantically equivalent
    return True
