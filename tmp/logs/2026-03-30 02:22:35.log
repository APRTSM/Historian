def semantically_equivalent(patch1, patch2):
    # Split the patches into lines and remove leading whitespaces
    patch1_lines = [line.lstrip() for line in patch1.split('\n') if line.startswith('+') or line.startswith('-')]
    patch2_lines = [line.lstrip() for line in patch2.split('\n') if line.startswith('+') or line.startswith('-')]
    
    # If the number of lines is not equal, they are not semantically equivalent
    if len(patch1_lines) != len(patch2_lines):
        return 'no'
    
    for line1, line2 in zip(patch1_lines, patch2_lines):
        # If the lines start with '-', they are not semantically equivalent
        if line1.startswith('-') and not line2.startswith('-'):
            return 'no'
        
        # If the lines start with '+', they are not semantically equivalent
        if line1.startswith('+') and not line2.startswith('+'):
            return 'no'
        
        # If the lines are different, they are not semantically equivalent
        if line1 != line2:
            return 'no'
    
    # All lines are equal, so the patches are semantically equivalent
    return 'yes'
