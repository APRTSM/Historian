    patch1 = [line.strip() for line in patch1]
    patch2 = [line.strip() for line in patch2]
    
    # Compare the two patches semantically
    if len(patch1) != len(patch2):
        return False  # Different number of lines, not equivalent
    
    for i in range(len(patch1)):
        p1 = patch1[i].split(' ')[1:]  # Split by space and skip the first word (e.g., '-', '+')
        p2 = patch2[i].split(' ')[1:]  # Split by space and skip the first word
        
        if len(p1) != len(p2):
            return False  # Different number of words on this line, not equivalent
        
