```python
def analyze_patches(patch1, patch2):
    # Split the patches into lines
    patch1_lines = patch1.split('\n')
    patch2_lines = patch2.split('\n')
    
    # Initialize counters for changes in code structure and content
    structural_changes = 0
    content_changes = 0
    
    # Analyze each line of the patches
    for i in range(max(len(patch1_lines), len(patch2_lines))):
        if i < len(patch1_lines) and i < len(patch2_lines):
            # If both lines are unchanged, continue to next pair of lines
            if patch1_lines[i].strip() == patch2_lines[i].strip():
                continue
            
            # Check for structural changes (deletion or addition)
            if patch1_lines[i][:3] in ['---', '+++'] or \
               patch2_lines[i][:3] in ['---', '+++']:
                structural_changes += 1
            
            # Check for content changes (modification)
            elif patch1_lines[i].startswith('-') != patch2_lines[i].startswith('-'):
                content_changes += 1
        
        else:  # one of the patches has more lines than the other
            structural_changes += max(len(patch1_lines), len(patch2_lines)) - i
    
    # Determine if the patches are semantically similar based on changes in code structure and content
    return 'yes' if structural_changes <= content_changes else 'no'
```

