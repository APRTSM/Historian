from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity
import re

# Function to clean the text data
def clean(text):
    # Removing backslash-apostrophe 
    text = re.sub("\'", "", text)
    # Removing anything not alphanumeric or a space
    text = re.sub("\W"," ", text)
    return text

# Function to calculate similarity score
def get_similarity(patch1, patch2):
    # Clean the data
    patch1 = clean(patch1)
    patch2 = clean(patch2)
    
    # Combine both patches into one document
    doc = f'{patch1} {patch2}'
    
    # Create a TfidfVectorizer object and fit_transform the data
    vectorizer = TfidfVectorizer().fit_transform([doc])
    
    # Get the vectors for each patch
    vec1, vec2 = vectorizer[0, :], vectorizer[0, :]
    
    # Calculate cosine similarity
    cosine_sim = cosine_similarity(vec1, vec2)
    
    return cosine_sim[0][1]  # Return the score for patch2
```

