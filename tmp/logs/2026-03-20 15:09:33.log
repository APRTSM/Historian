```python
def calculate_similarity(patch1, patch2):
    # Split each patch into lines
    lines1 = patch1.split('\n')
    lines2 = patch2.split('\n')
    
    # Count matching lines
    matching_lines = 0
    for line in lines1:
        if line in lines2:
            matching_lines += 1
            
    # Calculate similarity score
    similarity_score = matching_lines / max(len(lines1), len(lines2))
    
    return similarity_score
```

