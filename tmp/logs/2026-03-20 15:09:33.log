    for line in lines:
        if "Patch 1" in line or "Patch 2" in line:
            continue
        
        if "-" not in line and "+" not in line:
            continue
        
        if "@@ -" in line:
            current_patch = patch1 if "Patch 1" in lines[lines.index(line) - 1] else patch2
            continue
        
        if "-" in line and current_patch is not None:
