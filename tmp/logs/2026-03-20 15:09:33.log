def analyze_patches(patch1, patch2):
    # Split the patches into lines
    patch1_lines = patch1.split('\n')
    patch2_lines = patch2.split('\n')
    
    # Initialize counters for changes in each line
    context_changes = 0
    content_changes = 0
    
    # Iterate over the lines of both patches
    for i, (line1, line2) in enumerate(zip(patch1_lines, patch2_lines)):
        if line1.startswith('---') or line1.startswith('+++'):
            continue  # Skip the context lines
        
        # Check for changes in content
        if line1 != line2:
            content_changes += 1
            
        # Check for changes in context (e.g., number of lines)
        elif len(line1) != len(line2):
            context_changes += 1
    
    # If there are any significant changes, the patches are semantically similar
    if content_changes > 0 or context_changes > len(patch1_lines)/2:
        return 'yes'
    else:
        return 'no'
```

