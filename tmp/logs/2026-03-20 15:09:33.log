def analyze_patches(patch1, patch2):
    # Split the patches into lines
    patch1_lines = patch1.split('\n')
    patch2_lines = patch2.split('\n')
    
    # Initialize counters for changes in code structure and content
    structural_changes = 0
    content_changes = 0
    
    # Analyze each line of the patches
    for i in range(max(len(patch1_lines), len(patch2_lines))):
        try:
            patch1_line = patch1_lines[i]
            patch2_line = patch2_lines[i]
            
            # Check if the line is a structural change (starts with 'diff', '-' or '+')
            if patch1_line.startswith('diff') or patch1_line.startswith('-') or patch1_line.startswith('+'):
                structural_changes += 1
            
            # Check if the line is a content change (both lines start with '@@')
            elif patch1_line.startswith('@@') and patch2_line.startswith('@@'):
                content_changes += 1
        except IndexError:
            pass  # Ignore lines that are not in both patches
    
    # Determine if the patches are semantically similar based on the number of changes
    if structural_changes > 0 and content_changes == 0:
        return 'no'
    elif structural_changes > 0 and content_changes > 0:
        return 'no'
    else:
        return 'yes'
