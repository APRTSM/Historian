def calculate_similarity(patch1, patch2):
    # Combining the two patches into one string
    combined = f"{patch1}\n{patch2}"
    
    # Splitting the combined string into two separate strings for comparison
    patch1, patch2 = combined.split(f"\n{patch1}")[0], combined.split(f"\n{patch1}")[1]
    
