## Code:
```python
import difflib

def semantic_equivalence(patch1, patch2):
    # Split the patches into lines
    patch1_lines = patch1.split('\n')[3:]  # Skip the first three lines (metadata)
    patch2_lines = patch2.split('\n')[3:]
    
    # Compare line by line
    diff = difflib.SequenceMatcher(a=patch1_lines, b=patch2_lines)
    similarity = sum([match.size for match in diff.get_matches()]) / max(len(patch1_lines), len(patch2_lines))
    
    # If the lines are more similar than a certain threshold (e.g., 0.75), they're considered semantically equivalent
    semantic_equivalence = similarity > 0.75
    
    return 'yes' if semantic_equivalence else 'no'
```
