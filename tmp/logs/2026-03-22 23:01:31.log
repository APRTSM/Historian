import difflib
from collections import defaultdict

def analyze_patch(patch):
    lines = patch.split('\n')[2:]  # Skip the first two lines which are not relevant to semantic similarity
    similarities = defaultdict(list)
    
    for i in range(0, len(lines), 3):
        original_line = lines[i].strip()
        modified_line = lines[i+1].strip()
        
        if '---' not in original_line and '+++' not in original_line:
            original_words = set(original_line.split())
            modified_words = set(modified_line.split())
            
            common_words = original_words & modified_words  # Words that are present in both lines
            
            if len(common_words) > 0:
                similarities[original_line].append((len(common_words), modified_line))
    
    for line, similar_lines in similarities.items():
        print(f"Original Line: {line}")
        
        # Sort the lines by number of common words and then by length to break ties
        similar_lines.sort(key=lambda x: (-x[0], len(x[1])))  
        
        for count, modified_line in similar_lines:
            print(f"Similar Line ({count} common words): {modified_line}")
        print()
    
    return similarities

def are_semantically_similar(patch1, patch2):
    similarity = difflib.SequenceMatcher(a=patch1, b=patch2)
    return similarity.ratio() > 0.5  # Adjust this threshold as needed
```

