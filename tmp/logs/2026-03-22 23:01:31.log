def semantic_similarity(patch1, patch2):
    # Split the patches into lines
    patch1_lines = patch1.split('\n')[3:]  # Skip the first three lines which are metadata
    patch2_lines = patch2.split('\n')[3:]  # Skip the first three lines which are metadata
    
    # Initialize counters for similar and different lines
    similar = 0
    different = 0
    
    # Compare each line of the patches
    for i in range(min(len(patch1_lines), len(patch2_lines))):
        if patch1_lines[i].strip() == patch2_lines[i].strip():
            similar += 1
        else:
            different += 1
    
    # Report the number of similar and different lines
    print("Number of similar lines:", similar)
    print("Number of different lines:", different)
    
    # Determine if the patches are semantically similar based on a threshold
    semantic_similarity = 'yes' if similar > different else 'no'
    
    return semantic_similarity
```

