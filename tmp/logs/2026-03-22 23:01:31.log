def semantic_similarity(patch1, patch2):
    # Remove unnecessary lines from patches
    patch1 = re.sub(r'^\s*$', '', patch1, flags=re.MULTILINE)
    patch2 = re.sub(r'^\s*$', '', patch2, flags=re.MULTILINE)
    
