from sklearn.metrics import pairwise_distances
import numpy as np

def semantic_similarity(patch1, patch2):
    # Convert the patches to numerical vectors
    vectorizer = CountVectorizer().fit_transform([patch1, patch2])
    
    # Calculate cosine similarity between the two patches
